---
interface Props {
  title?: string;
}
const { title } = Astro.props;
const pageTitle = title
  ? `${title} | Luigi Alba Photography`
  : 'Luigi Alba | Photography';

const instagram = 'https://www.instagram.com/YOUR-USERNAME/';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <style is:global>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #0a0a0a;
        color: #f5f5f5;
        font-family: system-ui, sans-serif;
      }
      a { color: inherit; }

      /* Nav bar */
      .site-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1.5rem;
        padding: 1.25rem 1rem;
      }
      .logo { font-weight: 600; font-size: 1.1rem; text-decoration: none; }
      .site-header nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
      .site-header nav a { color: #a3a3a3; text-decoration: none; }
      .site-header nav a:hover,
      .site-header nav a.active { color: #f5f5f5; }

      /* Headings and text pages */
      .intro { padding: 2rem 1rem; text-align: center; }
      .intro h1 { margin: 0; font-size: 1.9rem; font-weight: 600; }
      .intro p { margin: 0.5rem 0 0; color: #a3a3a3; }
      .back { color: #a3a3a3; text-decoration: none; font-size: 0.9rem; }
      .page { max-width: 640px; margin: 0 auto; padding: 2rem 1rem 4rem; line-height: 1.7; }

      /* Masonry gallery */
      .gallery { columns: 2; column-gap: 0.75rem; padding: 0 0.75rem 3rem; }
      .gallery a { display: block; margin-bottom: 0.75rem; break-inside: avoid; }
      .gallery img { display: block; width: 100%; height: auto; border-radius: 4px; }

      /* Category cards */
      .category-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        padding: 0 0.75rem 3rem;
      }
      .category-card { text-decoration: none; }
      .category-card img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 4px;
      }
      .category-card span { display: block; margin-top: 0.5rem; }

      @media (min-width: 768px) {
        .gallery { columns: 3; }
        .category-grid { grid-template-columns: repeat(3, 1fr); }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">Luigi Alba</a>
      <nav>
        <a href="/" class={isActive('/') ? 'active' : ''}>Gallery</a>
        <a href={instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a>
        <a href="/categories" class={isActive('/categories') ? 'active' : ''}>Categories</a>
        <a href="/contact" class={isActive('/contact') ? 'active' : ''}>Contact</a>
        <a href="/about" class={isActive('/about') ? 'active' : ''}>About</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>